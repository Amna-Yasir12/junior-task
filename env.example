# --- Database ---
# Point this at an empty local PostgreSQL database.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/medusa_junior

# --- CORS ---
# The storefront origin (Next.js dev server runs on 8000).
STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:8000,http://localhost:9000

# --- Secrets ---
# Change these to any random strings for local dev.
JWT_SECRET=change-me
COOKIE_SECRET=change-me
